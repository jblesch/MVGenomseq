{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://raw.githubusercontent.com/BfArM-MVH/MVGenomseq_GRZ/v2.0.0/GRZ/grz-schema.json",
  "version":"2.0.0",
  "title":"Metadata Submission Genomic Data Center (GRZ)",
  "description":"General metadata schema for submissions to the GRZ",
  "type":"object",
  "required":[
    "submission",
    "donors"
  ],
  "properties":{
    "submission":{
      "type":"object",
      "required":[
        "submissionDate",
        "submissionType",
        "tanG",
        "localCaseId",
        "coverageType",
        "submitterId",
        "genomicDataCenterId",
        "clinicalDataNodeId",
        "diseaseType",
        "genomicStudyType",
        "genomicStudySubtype",
        "labName"
      ],
      "properties":{
        "schemaVersion":{
          "type":"string",
          "description":"Version of the GRZ metadata schema this submission conforms to, e.g. '2.0.0'.",
          "pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "submissionDate":{
          "type":"string",
          "description":"Date of submission in ISO 8601 format YYYY-MM-DD",
          "format":"date"
        },
        "submissionType":{
          "type":"string",
          "description":"The options are: 'initial' for first submission, 'followup' is for followup submissions, 'addition' for additional submission, 'correction' for correction",
          "enum":[
            "initial",
            "followup",
            "addition",
            "correction",
            "test"
          ]
        },
        "tanG":{
          "type":"string",
          "description":"The VNg of the genomic data of the index patient that will be reimbursed --> a unique 32-length byte code represented in a hex string of length 64.",
          "pattern":"^[a-fA-F0-9]{64}$"
        },
        "localCaseId":{
          "type":"string",
          "description":"A local case identifier of the Leistungserbringer to be able to track multiple submissions referring to the same index patient"
        },
        "coverageType":{
          "type":"string",
          "description": "\"GKV\" gesetzliche Krankenversicherung, \"PKV\" private Krankenversicherung, \"BG\" Berufsgenossenschaft, \"SEL\" Selbstzahler, \"SOZ\" Sozialamt, \"GPV\" gesetzliche Pflegeversicherung, \"PPV\" private Pflegeversicherung, \"BEI\" Beihilfe, \"SKT\" Sonstige Kostenträger, \"UNK\" Unbekannt",
          "enum":[
            "GKV",
            "PKV",
            "BG",
            "SEL",
            "SOZ",
            "GPV",
            "PPV",
            "BEI",
            "SKT",
            "UNK"
          ]
        },
        "submitterId":{
          "type":"string",
          "description":"Institutional ID of the submitter according to §293 SGB V.",
          "pattern":"^[0-9]{9}$"
        },
        "genomicDataCenterId":{
          "type":"string",
          "description":"ID of the genomic data center in the format GRZXXXnnn.",
          "pattern":"^(GRZ)[A-Z0-9]{3}[0-9]{3}$"
        },
        "clinicalDataNodeId":{
          "type":"string",
          "description":"ID of the clinical data node in the format KDKXXXnnn.",
          "pattern":"^(KDK)[A-Z0-9]{3}[0-9]{3}$"
        },
        "diseaseType":{
          "type":"string",
          "description":"Type of the disease",
          "enum":[
            "oncological",
            "rare",
            "hereditary"
          ]
        },
        "genomicStudyType":{
          "type":"string",
          "description":"whether additional persons are tested as well",
          "enum":[
            "single",
            "duo",
            "trio"
          ]
        },
        "genomicStudySubtype":{
          "type":"string",
          "description":"whether tumor and/or germ-line are tested",
          "enum":[
            "tumor-only",
            "tumor+germline",
            "germline-only"
          ]
        },
        "labName":{
          "type":"string",
          "description":"Name of the sequencing lab."
        }
      }
    },
    "donors":{
      "type":"array",
      "description":"List of donors including the index patient.",
      "items":{
        "type":"object",
        "required":[
          "donorPseudonym",
          "gender",
          "relation",
          "mvConsent",
          "researchConsents",
          "labData"
        ],
        "if":{
          "required":[
            "relation"
          ],
          "properties":{
            "relation":{
              "const":"other"
            }
          }
        },
        "then":{
          "required":[
            "relationOther"
          ]
        },
        "properties":{
          "donorPseudonym":{
            "type":"string",
            "description":"A unique identifier given by the Leistungserbringer for each donor of a single, duo or trio sequencing; the donorPseudonym needs to be identifiable by the Leistungserbringer in case of changes to the consents by one of the donors. For Index patient use index."
          },
          "gender":{
            "type":"string",
            "description":"Gender of the donor.",
            "enum":[
              "male",
              "female",
              "other",
              "unknown"
            ]
          },
          "relation":{
            "type":"string",
            "description":"Relationship of the donor in respect to the index patient, e.g. 'index', 'brother', 'mother', etc.",
            "enum":[
              "mother",
              "father",
              "brother",
              "sister",
              "child",
              "index",
              "aunt",
              "uncle",
              "grandparent",
              "grandchild",
              "other"
            ]
          },
          "relationOther":{
            "type":"string",
            "description":"Specification of the relationship to the index patient if 'relation' is 'other'. Required in that case.",
            "minLength":1
          },
          "mvConsent":{
            "type":"object",
            "properties":{
              "presentationDate":{
                "type":"string",
                "description":"Date of delivery. Date (in ISO 8601 format YYYY-MM-DD) on which the Model Project Declaration of Participation was presented to the patient, unless identical to the date of signature",
                "format":"date"
              },
              "version":{
                "type":"string",
                "description":"Version of the declaration of participation. Name and version of the declaration of participation in the MV GenomSeq, e.g.: 'Patient Info TE Consent MVGenomSeq vers01'"
              },
              "scope":{
                "type":"array",
                "description":"Modules of the consent to MV: must have at least a permit of mvSequencing",
                "items":{
                  "type":"object",
                  "properties":{
                    "type":{
                      "type":"string",
                      "description":"Consent or refusal to participate and consent, must be indicated for each option listed in the scope of consent.",
                      "enum":[
                        "permit",
                        "deny"
                      ]
                    },
                    "date":{
                      "type":"string",
                      "description":"Date of signature of the pilot projects consent; in ISO 8601 format YYYY-MM-DD.",
                      "format":"date"
                    },
                    "domain":{
                      "type":"string",
                      "description":"Scope of consent or revocation.",
                      "enum":[
                        "mvSequencing",
                        "reIdentification",
                        "caseIdentification"
                      ]
                    }
                  },
                  "required":[
                    "type",
                    "date",
                    "domain"
                  ]
                }
              }
            },
            "required":[
              "version",
              "scope"
            ]
          },
          "researchConsents":{
            "type":"array",
            "description":"Research consents. Multiple declarations of consent are possible! Must be assigned to the respective data sets.",
            "items":{
              "type":"object",
              "required":[
                "presentationDate"
              ],
              "properties":{
                "schemaVersion":{
                  "type":"string",
                  "description":"Schema version of de.medizininformatikinitiative.kerndatensatz.consent",
                  "enum":[
                    "2025.0.1",
                    "2025.0.2",
                    "2025.0.3",
                    "2025.0.4",
                    "2026.0.0",
                    "2026.0.1"
                  ]
                },
                "presentationDate":{
                  "type":"string",
                  "description":"Date of the delivery of the research consent in ISO 8601 format (YYYY-MM-DD)",
                  "format":"date"
                },
                "scope":{
                  "type":"object",
                  "description":"Scope of the research consent in JSON format following the MII IG Consent v2025 FHIR schema. See 'https://www.medizininformatik-initiative.de/Kerndatensatz/KDS_Consent_V2025/MII-IG-Modul-Consent.html' and 'https://packages2.fhir.org/packages/de.medizininformatikinitiative.kerndatensatz.consent'."
                },
                "noScopeJustification": {
                  "type": "string",
                  "description": "Justification if no scope object is present.",
                  "enum": [
                    "patient unable to consent",
                    "patient refuses to sign consent",
                    "patient did not return consent documents",
                    "other patient-related reason",
                    "consent information cannot be submitted by LE due to technical reason",
                    "consent is not implemented at LE due to organizational issues"
                  ]  
                }  
              },
              "oneOf": [
                {"required":["scope"]},
                {"required":["noScopeJustification"]}
              ]
            }
          },
          "labData":{
            "type":"array",
            "description":"Lab data related to the donor.",
            "if":{
              "contains":{
                "required":[
                  "sequenceData"
                ],
                "properties":{
                  "sequenceData":{
                    "required":[
                      "files"
                    ],
                    "properties":{
                      "files":{
                        "contains":{
                          "required":[
                            "fileType"
                          ],
                          "properties":{
                            "fileType":{
                              "enum":[
                                "bam",
                                "fastq"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "then":{
              "description":"If any BAM or FASTQ file is submitted for a donor, at least one VCF file must be submitted for the same donor, so that research-consented submissions can be reanalyzed without reprocessing the raw sequence data and so that every VCF is unambiguously attributable to a donor. Where variants are called jointly, for example across a trio or a tumor/normal pair, the resulting VCF is to be listed under each donor it covers.",
              "contains":{
                "required":[
                  "sequenceData"
                ],
                "properties":{
                  "sequenceData":{
                    "required":[
                      "files"
                    ],
                    "properties":{
                      "files":{
                        "contains":{
                          "required":[
                            "fileType"
                          ],
                          "properties":{
                            "fileType":{
                              "const":"vcf"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "items":{
              "type":"object",
              "required":[
                "labDataName",
                "tissueOntology",
                "tissueTypeId",
                "tissueTypeName",
                "sampleDate",
                "sampleConservation",
                "sequenceType",
                "sequenceSubtype",
                "caseControlStatus",
                "fragmentationMethod",
                "libraryType",
                "libraryPrepKit",
                "libraryPrepKitManufacturer",
                "sequencerModel",
                "kitName",
                "kitManufacturer",
                "enrichmentKitManufacturer",
                "enrichmentKitDescription",
                "barcode",
                "sequencingLayout"
              ],
              "allOf":[
                {
                  "if":{
                    "required":[
                      "tissueOntology"
                    ],
                    "properties":{
                      "tissueOntology":{
                        "required":[
                          "name"
                        ],
                        "properties":{
                          "name":{
                            "const":"snomed_ct"
                          }
                        }
                      }
                    }
                  },
                  "then":{
                    "properties":{
                      "tissueTypeId":{
                        "pattern":"^[0-9]{6,18}$"
                      }
                    }
                  }
                },
                {
                  "if":{
                    "required":[
                      "tissueOntology"
                    ],
                    "properties":{
                      "tissueOntology":{
                        "required":[
                          "name"
                        ],
                        "properties":{
                          "name":{
                            "const":"uberon"
                          }
                        }
                      }
                    }
                  },
                  "then":{
                    "properties":{
                      "tissueTypeId":{
                        "pattern":"^UBERON[:_][0-9]{7}$"
                      }
                    }
                  }
                },
                {
                  "if":{
                    "required":[
                      "tissueOntology"
                    ],
                    "properties":{
                      "tissueOntology":{
                        "required":[
                          "name"
                        ],
                        "properties":{
                          "name":{
                            "const":"bto"
                          }
                        }
                      }
                    }
                  },
                  "then":{
                    "properties":{
                      "tissueTypeId":{
                        "pattern":"^BTO[:_][0-9]{7}$"
                      }
                    }
                  }
                },
                {
                  "if":{
                    "required":[
                      "readStructure"
                    ],
                    "properties":{
                      "readStructure":{
                        "contains":{
                          "required":[
                            "segmentType"
                          ],
                          "properties":{
                            "segmentType":{
                              "const":"umi"
                            }
                          }
                        }
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "umiKitName",
                      "umiKitManufacturer",
                      "customUmiUsed"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "sampleConservation"
                    ],
                    "properties":{
                      "sampleConservation":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "sampleConservationOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "fragmentationMethod"
                    ],
                    "properties":{
                      "fragmentationMethod":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "fragmentationMethodOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "enrichmentKitManufacturer"
                    ],
                    "properties":{
                      "enrichmentKitManufacturer":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "enrichmentKitManufacturerOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "sequencerModel"
                    ],
                    "properties":{
                      "sequencerModel":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "sequencerModelOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "sequencingLayout"
                    ],
                    "properties":{
                      "sequencingLayout":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "sequencingLayoutOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "libraryType"
                    ],
                    "properties":{
                      "libraryType":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "libraryTypeOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "sequencerManufacturer"
                    ],
                    "properties":{
                      "sequencerManufacturer":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "sequencerManufacturerOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "libraryPrepKitManufacturer"
                    ],
                    "properties":{
                      "libraryPrepKitManufacturer":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "libraryPrepKitManufacturerOther"
                    ]
                  }
                },
                {
                  "if":{
                    "required":[
                      "kitManufacturer"
                    ],
                    "properties":{
                      "kitManufacturer":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "kitManufacturerOther"
                    ]
                  }
                }
              ],
              "properties":{
                "labDataName":{
                  "type":"string",
                  "description":"Name/ID of the biospecimen e.g. 'Blut DNA normal'"
                },
                "tissueOntology":{
                  "type":"object",
                  "required":[
                    "name",
                    "version"
                  ],
                  "if":{
                    "required":[
                      "name"
                    ],
                    "properties":{
                      "name":{
                        "const":"other"
                      }
                    }
                  },
                  "then":{
                    "required":[
                      "nameOther"
                    ]
                  },
                  "properties":{
                    "name":{
                      "type":"string",
                      "description":"Ontology from which tissueTypeId is taken. 'bto' BRENDA Tissue Ontology, 'uberon' Uberon anatomy ontology, 'snomed_ct' SNOMED CT body structures. These name anatomical structures; classifications of the disease rather than the tissue do not belong here. If another tissue ontology is used, set 'other' and name it in nameOther.",
                      "enum":[
                        "bto",
                        "uberon",
                        "snomed_ct",
                        "other"
                      ]
                    },
                    "nameOther":{
                      "type":"string",
                      "description":"Name of the tissue ontology actually used. Required if name is 'other'.",
                      "minLength":1
                    },
                    "version":{
                      "type":"string",
                      "description":"Version or release of the tissue ontology."
                    }
                  }
                },
                "tissueTypeId":{
                  "type":"string",
                  "description":"Identifier of the tissue in the ontology named by tissueOntology.name. Both the CURIE form (BTO:0000089) and the OBO form (BTO_0000089) are accepted for BTO and UBERON; SNOMED CT concept identifiers are given as plain numbers."
                },
                "tissueTypeName":{
                  "type":"string",
                  "description":"Tissue name according to the ontology in use."
                },
                "sampleDate":{
                  "type":"string",
                  "description":"Date of sample in ISO 8601 format YYYY-MM-DD",
                  "format":"date"
                },
                "sampleConservation":{
                  "type":"string",
                  "description":"How the sample was conserved and stored. 'refrigerator', 'freezer', 'ultra-low-freezer' and 'cryogenic-freezer' record the storage temperature; 'ffpe' formalin-fixed and paraffin-embedded; 'none' that no storage method was applied. 'fresh-tissue' is retained for tissue processed without storage; prefer 'none' where it applies.",
                  "enum":[
                    "refrigerator",
                    "freezer",
                    "ultra-low-freezer",
                    "cryogenic-freezer",
                    "ffpe",
                    "fresh-tissue",
                    "none",
                    "other",
                    "unknown"
                  ]
                },
                "sampleConservationOther":{
                  "type":"string",
                  "description":"Specification of how the sample was conserved if 'sampleConservation' is 'other'. Required in that case.",
                  "minLength":1
                },
                "sequenceType":{
                  "type":"string",
                  "description":"Type of sequence (DNA or RNA)",
                  "enum":[
                    "dna",
                    "rna"
                  ]
                },
                "sequenceSubtype":{
                  "type":"string",
                  "description":"Subtype of the sequence: 'germline' or 'somatic'.",
                  "enum":[
                    "germline",
                    "somatic"
                  ]
                },
                "caseControlStatus":{
                  "type":"string",
                  "description":"Whether this sample is a case or a control for the phenotype under consideration. Describes the role of the sample in the study design, not the material itself; the matched normal of a tumor/normal pair is therefore 'control'.",
                  "enum":[
                    "case",
                    "control"
                  ]
                },
                "fragmentationMethod":{
                  "type":"string",
                  "description":"Method used to fragment the nucleic acid: 'sonication', 'enzymatic', 'none' where the material was not fragmented, or 'other', which must be named in fragmentationMethodOther.",
                  "enum":[
                    "sonication",
                    "enzymatic",
                    "none",
                    "other"
                  ]
                },
                "fragmentationMethodOther":{
                  "type":"string",
                  "description":"Specification of the fragmentation method used if 'fragmentationMethod' is 'other'. Required in that case.",
                  "minLength":1
                },
                "libraryType":{
                  "type":"string",
                  "description":"Library type: 'wgs' whole genome sequencing, 'wes' whole exome sequencing, 'panel' a targeted gene panel, each with an '_lr' variant for long-read sequencing; 'other' a library type not covered by this list, which must then be named in libraryTypeOther.",
                  "enum":[
                    "panel",
                    "panel_lr",
                    "wes",
                    "wes_lr",
                    "wgs",
                    "wgs_lr",
                    "other"
                  ]
                },
                "libraryTypeOther":{
                  "type":"string",
                  "description":"Specification of the library type if 'libraryType' is 'other'. Required in that case.",
                  "minLength":1
                },
                "libraryPrepKit":{
                  "type":"string",
                  "minLength":1,
                  "description":"Name of the kit used to construct the library, as free text. The field is deliberately not controlled: library preparation kits are released continuously and laboratories also use custom designs, so no closed list can hold them. Record the manufacturer in libraryPrepKitManufacturer, which is controlled, and give the kit name here as precisely as the supplier states it."
                },
                "libraryPrepKitManufacturer":{
                  "type":"string",
                  "description":"Manufacturer of the library preparation kit. If the manufacturer is not listed, use 'other' and name it in libraryPrepKitManufacturerOther; use 'none' where no kit was used.",
                  "enum":[
                    "illumina",
                    "twist",
                    "neb",
                    "agilent",
                    "idt",
                    "qiagen",
                    "oncodna",
                    "thermo_fisher",
                    "oxford_nanopore",
                    "watchmaker",
                    "mgi",
                    "pacific_biosciences",
                    "other",
                    "none"
                  ]
                },
                "libraryPrepKitManufacturerOther":{
                  "type":"string",
                  "minLength":1,
                  "description":"Name of the library preparation kit manufacturer. Required if 'libraryPrepKitManufacturer' is 'other'."
                },
                "sequencerModel":{
                  "$ref":"vocabularies/instrument-model.json",
                  "description":"Name and model of the sequencing platform. Values come from the controlled vocabulary in vocabularies/instrument-model.json. Use 'other' and sequencerModelOther if the model is not listed."
                },
                "sequencerModelOther":{
                  "type":"string",
                  "description":"Name and version of the sequencer model used. Required if 'sequencerModel' is 'other'.",
                  "minLength":1
                },
                "sequencerManufacturer":{
                  "type":"string",
                  "description":"Manufacturer of the sequencing instrument. Optional: for every value of sequencerModel except 'other' and 'unspecified' the manufacturer follows from the model. Where it is given it must be one of these values; if the manufacturer is not listed, use 'other' and name it in sequencerManufacturerOther.",
                  "enum":[
                    "illumina",
                    "thermo_fisher",
                    "oxford_nanopore",
                    "pacific_biosciences",
                    "mgi",
                    "element_biosciences",
                    "helicos",
                    "ultima_genomics",
                    "other"
                  ]
                },
                "sequencerManufacturerOther":{
                  "type":"string",
                  "description":"Name of the sequencer manufacturer. Required if 'sequencerManufacturer' is 'other'.",
                  "minLength":1
                },
                "kitName":{
                  "type":"string",
                  "description":"Name/version of the sequencing kit"
                },
                "kitManufacturer":{
                  "type":"string",
                  "description":"Manufacturer of the sequencing kit. The same list of manufacturers as libraryPrepKitManufacturer and enrichmentKitManufacturer. If the manufacturer is not listed, use 'other' and name it in kitManufacturerOther.",
                  "enum":[
                    "illumina",
                    "twist",
                    "neb",
                    "agilent",
                    "idt",
                    "qiagen",
                    "oncodna",
                    "thermo_fisher",
                    "oxford_nanopore",
                    "watchmaker",
                    "mgi",
                    "pacific_biosciences",
                    "other",
                    "none"
                  ]
                },
                "kitManufacturerOther":{
                  "type":"string",
                  "minLength":1,
                  "description":"Name of the sequencing kit manufacturer. Required if 'kitManufacturer' is 'other'."
                },
                "enrichmentKitManufacturer":{
                  "type":"string",
                  "description":"Manufacturer of the enrichment kit. The same list of manufacturers as libraryPrepKitManufacturer. Use 'none' where no enrichment was performed; if the manufacturer is not listed, use 'other' and name it in enrichmentKitManufacturerOther.",
                  "enum":[
                    "illumina",
                    "twist",
                    "neb",
                    "agilent",
                    "idt",
                    "qiagen",
                    "oncodna",
                    "thermo_fisher",
                    "oxford_nanopore",
                    "watchmaker",
                    "mgi",
                    "pacific_biosciences",
                    "other",
                    "none"
                  ]
                },
                "enrichmentKitManufacturerOther":{
                  "type":"string",
                  "description":"Specification of the manufacturer of the enrichment kit if 'enrichmentKitManufacturer' is 'other'. Required in that case.",
                  "minLength":1
                },
                "enrichmentKitDescription":{
                  "type":"string",
                  "description":"Name/version of the enrichment kit"
                },
                "barcode":{
                  "type":"string",
                  "description":"The barcode sequence used for this sample, or 'na'. This is the sequence itself; its position within the reads is described by readStructure."
                },
                "readStructure":{
                  "type":"array",
                  "description":"Positions of the UMI and barcode segments within the sequencing reads. Describes the library design and therefore applies to all files of this labData entry. Offsets are 0-based from the start of the respective read.",
                  "minItems":1,
                  "items":{
                    "type":"object",
                    "required":[
                      "readType",
                      "offset",
                      "length",
                      "segmentType"
                    ],
                    "properties":{
                      "readType":{
                        "type":"string",
                        "description":"The read in which this segment is located.",
                        "enum":[
                          "R1",
                          "R2",
                          "I1",
                          "I2"
                        ]
                      },
                      "offset":{
                        "type":"integer",
                        "description":"0-based offset of the segment from the start of the read.",
                        "minimum":0
                      },
                      "length":{
                        "type":"integer",
                        "description":"Length of the segment in bases.",
                        "minimum":1
                      },
                      "segmentType":{
                        "type":"string",
                        "description":"What the segment encodes: 'umi' unique molecular identifier, 'sampleBarcode' sample index, 'spacer' a skipped region, 'insert' the template sequence.",
                        "enum":[
                          "umi",
                          "sampleBarcode",
                          "spacer",
                          "insert"
                        ]
                      }
                    }
                  }
                },
                "umiKitName":{
                  "type":"string",
                  "description":"Name/version of the kit used to introduce the UMIs. Required if readStructure declares a 'umi' segment.",
                  "minLength":1
                },
                "umiKitManufacturer":{
                  "type":"string",
                  "description":"Manufacturer of the UMI kit. Required if readStructure declares a 'umi' segment.",
                  "minLength":1
                },
                "customUmiUsed":{
                  "type":"boolean",
                  "description":"Whether customized UMIs were used instead of the kit's standard UMIs. Required if readStructure declares a 'umi' segment."
                },
                "sequencingLayout":{
                  "type":"string",
                  "description":"The sequencing layout, aka the end type of sequencing: 'single-end' one read per fragment, 'paired-end' two reads per fragment, 'other' a layout not covered by this list.",
                  "enum":[
                    "single-end",
                    "paired-end",
                    "other"
                  ]
                },
                "sequencingLayoutOther":{
                  "type":"string",
                  "description":"Specification of the sequencing layout if 'sequencingLayout' is 'other'. Required in that case.",
                  "minLength":1
                },
                "tumorCellCount":{
                  "type":"array",
                  "description":"Tuple of tumor cell counts and how they were determined.",
                  "items":{
                    "type":"object",
                    "required":[
                      "count",
                      "method"
                    ],
                    "properties":{
                      "count":{
                        "type":"number",
                        "description":"Tumor cell count in %",
                        "minimum":0,
                        "maximum":100
                      },
                      "method":{
                        "type":"string",
                        "description":"Method used to determine the tumor cell count. 'unknown' where a count was supplied without its provenance, for example from an external pathology report; 'other' for a method not listed, which must be named in methodOther.",
                        "enum":[
                          "pathology",
                          "bioinformatics",
                          "other",
                          "unknown"
                        ]
                      },
                      "methodOther":{
                        "type":"string",
                        "minLength":1,
                        "description":"Specification of the method used to determine the tumor cell count if 'method' is 'other'. Required in that case."
                      }
                    },
                    "if":{
                      "required":[
                        "method"
                      ],
                      "properties":{
                        "method":{
                          "const":"other"
                        }
                      }
                    },
                    "then":{
                      "required":[
                        "methodOther"
                      ]
                    }
                  }
                },
                "sequenceData":{
                  "type":"object",
                  "description":"Sequence data generated from the wet lab experiment.",
                  "required":[
                    "bioinformaticsPipelineName",
                    "bioinformaticsPipelineVersion",
                    "referenceGenome",
                    "percentBasesAboveQualityThreshold",
                    "meanDepthOfCoverage",
                    "minCoverage",
                    "targetedRegionsAboveMinCoverage",
                    "files",
                    "nonCodingVariants",
                    "callerUsed"
                  ],
                  "properties":{
                    "bioinformaticsPipelineName":{
                      "type":"string",
                      "description":"Name of the bioinformatics pipeline used"
                    },
                    "bioinformaticsPipelineVersion":{
                      "type":"string",
                      "description":"Version or commit hash of the bioinformatics pipeline"
                    },
                    "referenceGenome":{
                      "type":"string",
                      "description":"Reference genome used according to the Genome Reference Consortium (https://www.ncbi.nlm.nih.gov/grc)",
                      "enum":[
                        "GRCh37",
                        "GRCh38"
                      ]
                    },
                    "percentBasesAboveQualityThreshold":{
                      "type":"object",
                      "description":"Percentage of bases with a specified minimum quality threshold, according to https://www.bfarm.de/SharedDocs/Downloads/DE/Forschung/modellvorhaben-genomsequenzierung/Qs-durch-GRZ.pdf?__blob=publicationFile",
                      "properties":{
                        "minimumQuality":{
                          "type":"number",
                          "description":"The minimum quality score threshold",
                          "minimum":0
                        },
                        "percent":{
                          "type":"number",
                          "description":"Percentage of bases that meet or exceed the minimum quality score",
                          "minimum":0,
                          "maximum":100
                        }
                      },
                      "required":[
                        "minimumQuality",
                        "percent"
                      ]
                    },
                    "meanDepthOfCoverage":{
                      "type":"number",
                      "description":"Mean depth of coverage",
                      "minimum":0
                    },
                    "minCoverage":{
                      "type":"number",
                      "description":"Minimum coverage",
                      "minimum":0
                    },
                    "targetedRegionsAboveMinCoverage":{
                      "type":"number",
                      "description":"Fraction of targeted regions that are above minimum coverage",
                      "minimum":0,
                      "maximum":1
                    },
                    "nonCodingVariants":{
                      "type":"boolean",
                      "description":"The analysis includes non-coding variants -> true or false"
                    },
                    "callerUsed":{
                      "type":"array",
                      "description":"Caller that is used in the pipeline",
                      "items":{
                        "type":"object",
                        "required":[
                          "name",
                          "version"
                        ],
                        "properties":{
                          "name":{
                            "type":"string",
                            "description":"Name of the caller used"
                          },
                          "version":{
                            "type":"string",
                            "description":"Version of the caller used"
                          }
                        }
                      }
                    },
                    "files":{
                      "type":"array",
                      "description":"List of files generated and required in this analysis. If BAM or FASTQ files are submitted for a DNA variant-calling library, at least one VCF file must be submitted for the same donor; see the conditional rule on labData.",
                      "items":{
                        "type":"object",
                        "required":[
                          "filePath",
                          "fileType",
                          "fileChecksum",
                          "fileSizeInBytes"
                        ],
                        "if": {
                          "properties": {
                            "fileType": {
                              "enum": ["bam", "fastq"]
                            }
                          }
                        },
                        "then": {
                          "required": ["readLength"]
                        },
                        "properties":{
                          "filePath":{
                            "type":"string",
                            "description": "Path relative to the submission files directory, e.g.: 'patient_001/patient_001_dna.fastq.gz' if the file is located in <submission root>/files/patient_001/patient_001_dna.fastq.gz"
                          },
                          "fileType":{
                            "type":"string",
                            "description":"Type of the file; if BED file is submitted, only 1 file is allowed.",
                            "enum":[
                              "bam",
                              "vcf",
                              "bed",
                              "fastq"
                            ]
                          },
                          "checksumType":{
                            "type":"string",
                            "description":"Type of checksum algorithm used",
                            "enum":[
                              "sha256"
                            ],
                            "default":"sha256"
                          },
                          "fileChecksum":{
                            "type":"string",
                            "description":"checksum of the file",
                            "pattern":"^[a-fA-F0-9]{64}$"
                          },
                          "fileSizeInBytes":{
                            "type":"number",
                            "description":"Size of the file in bytes",
                            "minimum":0
                          },
                          "readOrder":{
                            "type":"string",
                            "enum":[
                              "R1",
                              "R2",
                              "I1",
                              "I2"
                            ],
                            "description":"Indicates which read this file contains: R1 and R2 for the template reads of a paired-end run, I1 and I2 for the index reads."
                          },
                          "readLength":{
                            "type":"integer",
                            "description":"The read length; in the case of long-read sequencing it is the rounded average read length.",
                            "minimum":0
                          },
                          "flowcellId":{
                            "type":"string",
                            "description":"Indicates the flow cell."
                          },
                          "laneId":{
                            "type":"string",
                            "description":"Indicates the lane"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
